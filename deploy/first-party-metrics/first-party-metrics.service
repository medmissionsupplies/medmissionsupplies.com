[Unit]
Description=Private aggregate website measurement
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/first-party-metrics/current
ExecStart=/usr/bin/python3 /opt/first-party-metrics/current/server.py
Restart=on-failure
RestartSec=3
StateDirectory=first-party-metrics
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/first-party-metrics
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=128M
TasksMax=32
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
